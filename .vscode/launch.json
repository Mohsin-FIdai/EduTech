{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "▶ Run Demo",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/demo.py",
            "console": "integratedTerminal",
            "env": {
                "PYTHONUTF8": "1"
            }
        },
        {
            "name": "🧪 Run All Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/", "-v"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONUTF8": "1"
            }
        },
        {
            "name": "🧪 Run Gold Set Eval",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/test_gold_set.py", "-v", "-s"],
            "console": "integratedTerminal",
            "env": {
                "PYTHONUTF8": "1"
            }
        }
    ]
}

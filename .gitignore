# Python caches / build artefacts
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Runtime SQLite databases & sidecar files
*.db
*.db-shm
*.db-wal

# Runtime logs & media storage (preserve folder placeholders)
logs/*.log
storage/logs/
storage/uploads/*
!storage/uploads/.gitkeep
storage/processed/*
!storage/processed/.gitkeep
storage/chunks/*
!storage/chunks/.gitkeep

# Third-party installers / caches (not project data)
benchmark_tmp/

# Secrets
.env
.env.*

# Model weights live outside the repo; see models/MODELS.md and models/download_models.py
*.safetensors
*.pt
*.gguf
